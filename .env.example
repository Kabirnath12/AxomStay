# Copy these values into your shell environment before npm start.
# Gmail OAuth: create a Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Indian payment gateway. Without these, checkout uses local demo payment mode.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox

# Optional manual UPI fallback while payment-gateway KYC is pending.
UPI_ID=yourname@upi

# Twilio Verify-by-SMS delivery. Use either a phone number or messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Optional: set production to stop returning demo OTP/reset codes.
NODE_ENV=development

# MERN app settings
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/new-horizon-farm
CLIENT_URL=http://localhost:5173
ADMIN_KEY=change-this-before-deploying
