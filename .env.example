# Copy these values into your shell environment before npm start.
# Gmail OAuth: create a Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Indian payment gateway. Without these, checkout uses local demo payment mode.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox

# Twilio Verify-by-SMS delivery. Use either a phone number or messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Optional: set production to stop returning demo OTP/reset codes.
NODE_ENV=development
